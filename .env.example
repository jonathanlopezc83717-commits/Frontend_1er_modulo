# Variables de entorno para Supabase Local
VITE_SUPABASE_URL=http://localhost:54321
VITE_SUPABASE_ANON_KEY=tu-anon-key-de-supabase-local

# OPENROUTER_API_KEY se configura como secret de Supabase Edge Function:
#   supabase secrets set OPENROUTER_API_KEY=<tu-key>
# No exponerla en el bundle del cliente.

# Watcher de carpeta local sincronizada por Synology Drive
# Ejemplo Windows: C:\Users\TU_USUARIO\SynologyDrive\Obras
NAS_WATCH_PATH=
NAS_WATCH_INTERVAL_MS=5000
NAS_WATCH_HASH_LIMIT_MB=50

# API local de croquis (server/api_croquis.py, arrancada por start-app.cjs).
# La maquina que renderiza debe tener Civil 3D abierto y el NAS montado con la
# misma letra de unidad que usan las referencias ECW dentro del DWG.
# Desactivar el arranque automatico: CROQUIS_API_DISABLED=1
VITE_DWG_API_URL=http://127.0.0.1:8000/api/croquis

# --- Produccion (npm run start:prod) ---
# Orden de arranque (runbook):
#   1. npm run build
#   2. nas-watcher corriendo como tarea programada (proceso aparte, ADR-006)
#   3. npm run start:prod
# En produccion server/api_croquis.py sirve dist/, los endpoints NAS
# (/api/nas-pending, /api/nas-pending/ack, /api/nas-file) y el stream SSE
# /api/nas-stream. Sin NAS_WATCH_PATH esos endpoints devuelven 503.
CROQUIS_API_HOST=0.0.0.0
CROQUIS_API_PORT=8000
